{%- if product.tags contains 'size-directions' -%}

<style>
.product-size-guide__notification{
  background:#f2f2f2;
  padding:12px;
  margin-top:12px;
  border-left:3px solid #000;
  display:none;
  font-size:14px;
}
.product-size-guide__notification.active{
  display:block;
}
</style>

<div class="product-size-guide">
  <div class="product-size-guide__notification" id="sizeNote"></div>
</div>

<script>
(function(){

const productId = '{{ product.id }}';
const sectionId = '{{ sectionId }}';

const SIZE_RULES = {
  black: {
    default: "● Fits true to size."
  },
  "mid blue": {
    default: "↑ We recommend going one size up."
  },
  grey: {
    "32": "↑ Size 32 – go one size up.",
    default: "● Fits true to size."
  },
  "light blue": {
    "32": "↑ Size 32 – go one size up.",
    default: "● Fits true to size."
  },
  default: {
    "26": "↑ Runs small – go up.",
    "34": "↓ Runs large – go down.",
    default: "● Fits true to size."
  }
};

function getSelectedValue(optionName){
  const wrapper = document.querySelector(
    `[data-section='${sectionId}'][data-product-id='${productId}']`
  );
  if(!wrapper) return '';

  const selected = wrapper.querySelector(
    `[option-picker-name*="${optionName}"] .pill.selected .pill__label`
  );
  return selected ? selected.textContent.trim().toLowerCase() : '';
}

function getMessage(color, size){
  color = color.toLowerCase();
  let rule = SIZE_RULES.default;

  Object.keys(SIZE_RULES).forEach(key=>{
    if(color.includes(key)) rule = SIZE_RULES[key];
  });

  return rule[size] || rule.default;
}

function updateNote(){
  const color = getSelectedValue('Color');
  const size = getSelectedValue('Size');
  const note = document.getElementById('sizeNote');

  if(!size) return;

  const message = getMessage(color, size);
  note.innerHTML = `<strong>${size}</strong> — ${message}`;
  note.classList.add('active');
}

document.addEventListener('click', function(e){
  if(e.target.closest('.pill')){
    setTimeout(updateNote, 100);
  }
});

document.addEventListener('variant-changed', function(){
  setTimeout(updateNote, 100);
});

document.addEventListener('DOMContentLoaded', function(){
  setTimeout(updateNote, 200);
});

})();
</script>

{%- endif -%}