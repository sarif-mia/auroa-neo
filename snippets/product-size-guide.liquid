{%- if product.tags contains 'size-directions' -%}

<style>
.product-size-guide{
  margin-top:15px;
}

.product-size-guide__notification{
  background:#f5f5f5;
  padding:14px;
  border-left:4px solid #000;
  font-size:14px;
  display:none;
  transition:all .2s ease;
}

.product-size-guide__notification.active{
  display:block;
}

.product-size-guide__notification strong{
  font-weight:600;
}
</style>

<div class="product-size-guide">
  <div class="product-size-guide__notification" id="sizeNote"></div>
</div>

<script>
(function(){

const SIZE_RULES={
  black:{default:"● Fits true to size."},
  "mid blue":{default:"↑ We recommend going one size up."},
  grey:{"32":"↑ Size 32 — go one size up.",default:"● Fits true to size."},
  "light blue":{"32":"↑ Size 32 — go one size up.",default:"● Fits true to size."},
  default:{"26":"↑ Runs small — go up one size.","34":"↓ Runs large — go down one size.",default:"● Fits true to size."}
};

function getSelected(name){
  const el=document.querySelector(`[option-picker-name*="${name}"] .pill.selected .pill__label`);
  return el?el.textContent.trim().toLowerCase():"";
}

function getMessage(c,s){
  let r=SIZE_RULES.default;
  for(const k in SIZE_RULES) if(c.includes(k)) r=SIZE_RULES[k];
  return r[s]||r.default;
}

function updateSizeNote(){
  const color=getSelected('Color');
  const size=getSelected('Size');
  const note=document.getElementById('sizeNote');
  if(!size||!note) return;
  note.innerHTML=`<strong>Size ${size}</strong> — ${getMessage(color,size)}`;
  note.classList.add('active');
}

document.addEventListener('variant-changed',updateSizeNote);
document.addEventListener('click',e=>{if(e.target.closest('.pill'))updateSizeNote();});
document.addEventListener('DOMContentLoaded',updateSizeNote);

})();
</script>

{%- endif -%}