{%- if product.tags contains 'size-directions' -%}

<style>
.product-size-guide__notification{
  margin-top:1rem;padding:1rem;background:#e8e8e8;
  border-left:4px solid #333;display:none
}
.product-size-guide__notification.active{display:block}
.product-size-guide__notification-content{
  display:flex;gap:10px;align-items:center;font-size:.9rem
}
</style>

<div class="product-size-guide">
  <div class="product-size-guide__notification" data-size-note>
    <div class="product-size-guide__notification-content"></div>
  </div>
</div>

<script>
(function(){

const productId = '{{ product.id }}';
const sectionId = '{{ sectionId }}';
const OPTIONS = {{ product.options | json }};
const COLOR_INDEX = OPTIONS.findIndex(o=>o.toLowerCase().includes('color'));

function getColor(){
  const variantJson = document.querySelector(
    `[data-section='${sectionId}'][data-product-id='${productId}'] [data-selected-variant-json]`
  );
  if(!variantJson) return '';
  try{
    const v = JSON.parse(variantJson.textContent);
    return (v.options[COLOR_INDEX] || '').toLowerCase();
  }catch{return ''}
}

function getRecommendation(color,size){
  if(color.includes('mid blue'))
    return {icon:'↑',text:`Size ${size} — go one size up.`};

  if(color.includes('grey')||color.includes('light blue'))
    return size==='32'
      ? {icon:'↑',text:'Size 32 — go one size up.'}
      : {icon:'●',text:`Size ${size} fits true to size.`};

  if(color.includes('black'))
    return {icon:'●',text:`Size ${size} fits true to size.`};

  // default
  if(size==='26') return {icon:'↑',text:'Size 26 — go up to 28.'};
  if(size==='34') return {icon:'↓',text:'Size 34 — go down to 32.'};

  return {icon:'●',text:`Size ${size} fits true to size.`};
}

function showNote(data){
  const box=document.querySelector('[data-size-note]');
  const content=box?.querySelector('.product-size-guide__notification-content');
  if(!box||!content)return;
  content.innerHTML=`<strong>${data.icon}</strong> ${data.text}`;
  box.classList.add('active');
}

function init(){
  const wrapper=document.querySelector(
    `[data-section='${sectionId}'][data-product-id='${productId}']`
  );
  if(!wrapper)return;

  const sizeList=[...wrapper.querySelectorAll('.product-variant-picker__pill-list')]
    .find(l=>l.parentElement.innerText.toLowerCase().includes('size'));

  if(!sizeList)return;

  const color=getColor();

  sizeList.querySelectorAll('.pill').forEach(pill=>{
    const size=pill.innerText.trim();
    pill.onclick=()=>{
      const data=getRecommendation(color,size);
      showNote(data);
    };
  });

  // auto trigger selected
  const selected=sizeList.querySelector('.pill.selected')||sizeList.querySelector('.pill');
  if(selected) selected.click();
}

document.addEventListener('DOMContentLoaded',()=>setTimeout(init,100));
document.addEventListener('variant-changed',()=>setTimeout(init,50));

})();
</script>

{%- endif -%}