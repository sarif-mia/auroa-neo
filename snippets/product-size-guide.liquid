{%- liquid
  assign product_tags = product.tags
  assign has_size_directions_tag = false
  
  for tag in product_tags
    if tag == 'size-directions'
      assign has_size_directions_tag = true
      break
    endif
  endfor
-%}

{%- if has_size_directions_tag -%}
  <style>
    [data-size-recommendations] {
      position: relative;
    }

    [data-size-recommendations] .pill {
      position: relative;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    [data-size-recommendations] .pill:hover {
      transform: translateY(-2px);
    }

    .product-size-guide {
      margin-top: 1rem;
      margin-bottom: 0;
    }

    .product-size-guide__notification {
      background: #e8e8e8;
      padding: 1rem;
      border-left: 4px solid #333;
      margin-top: 1rem;
      display: none;
      animation: notificationSlide 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      border-radius: 0px;
      box-shadow: none;
    }

    .product-size-guide__notification.active {
      display: block;
    }

    .product-size-guide__notification-content {
      font-size: 0.95rem;
      line-height: 1.5;
      color: #333;
      font-weight: 400;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .product-size-guide__notification-icon {
      font-size: 1.2rem;
      font-weight: bold;
      min-width: 24px;
      text-align: center;
    }

    .product-size-guide__notification[data-icon="●"] .product-size-guide__notification-icon {
      color: #333;
    }

    .product-size-guide__notification[data-icon="↑"] .product-size-guide__notification-icon {
      color: #333;
    }

    .product-size-guide__notification[data-icon="↓"] .product-size-guide__notification-icon {
      color: #333;
    }

    @keyframes notificationSlide {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 768px) {
      .product-size-guide__notification {
        padding: 0.875rem;
      }

      .product-size-guide__notification-content {
        font-size: 0.85rem;
      }

      .product-size-guide__notification-icon {
        font-size: 1rem;
      }
    }
  </style>

  <div class='product-size-guide' data-product-size-guide>
    <div class='product-size-guide__notification' data-size-notification>
      <div class='product-size-guide__notification-content'></div>
    </div>
  </div>

  <script>
    (function() {
      // Configuration
      const SIZE_RECOMMENDATIONS = {
        '26': { icon: '↑', text: 'Size 26 runs small — we suggest going up to size 28.' },
        '28': { icon: '●', text: 'Size 28 fits true to size.' },
        '30': { icon: '●', text: 'Size 30 fits true to size.' },
        '32': { icon: '↑', text: 'Size 32 — we recommend going one size up.' },
        '34': { icon: '↓', text: 'Size 34 runs large — we suggest going down to size 32.' },
        '36': { icon: '●', text: 'Size 36 fits true to size.' }
      };

      const productId = '{{ product.id }}';
      const sectionId = '{{ sectionId }}';

      function findSizePillList() {
        const variantPicker = document.querySelector(
          `[data-section='${sectionId}'][data-product-id='${productId}']`
        );
        
        if (!variantPicker) {
          console.log('Variant picker not found');
          return null;
        }

        const allPillLists = variantPicker.querySelectorAll('.product-variant-picker__pill-list');
        
        for (let list of allPillLists) {
          const parent = list.parentElement;
          const labelSpans = parent.querySelectorAll('.product-variant-picker__option-label span');
          
          for (let span of labelSpans) {
            if (span.textContent.toLowerCase().trim() === 'size') {
              return list;
            }
          }
        }
        
        return null;
      }

      function updateNotification(recommendation) {
        const notification = document.querySelector('[data-size-notification]');
        const notificationContent = notification?.querySelector('.product-size-guide__notification-content');
        
        if (notificationContent && notification) {
          notification.setAttribute('data-icon', recommendation.icon);
          notificationContent.innerHTML = `
            <span class='product-size-guide__notification-icon'>${recommendation.icon}</span>
            <span>${recommendation.text}</span>
          `;
          notification.classList.add('active');
        }
      }

      function applySizeRecommendations(sizePillList) {
        if (!sizePillList) {
          console.log('Size pill list not found');
          return;
        }

        // Mark the list for styling
        sizePillList.setAttribute('data-size-recommendations', 'true');

        const pills = sizePillList.querySelectorAll('.pill');
        
        pills.forEach((pill, index) => {
          const label = pill.querySelector('.pill__label');
          const sizeText = label?.textContent.trim() || '';
          const recommendation = SIZE_RECOMMENDATIONS[sizeText];

          if (recommendation) {
            // Remove old click listeners by cloning
            const newPill = pill.cloneNode(true);
            pill.parentNode.replaceChild(newPill, pill);

            // Add click handler to new pill
            newPill.addEventListener('click', (e) => {
              e.stopPropagation();
              updateNotification(recommendation);
            });
          }
        });

        // Trigger initial recommendation
        const updatedList = document.querySelector('[data-size-recommendations="true"]');
        const selectedPill = updatedList?.querySelector('.pill.selected');
        
        if (selectedPill) {
          selectedPill.click();
        } else {
          const firstPill = updatedList?.querySelector('.pill');
          if (firstPill) {
            firstPill.click();
          }
        }
      }

      function initSizeGuide() {
        const sizePillList = findSizePillList();
        if (sizePillList) {
          applySizeRecommendations(sizePillList);
        }
      }

      // Initialize when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          setTimeout(initSizeGuide, 100);
        });
      } else {
        // Use setTimeout to ensure DOM elements are ready
        setTimeout(initSizeGuide, 100);
      }

      // Re-initialize on variant changes
      document.addEventListener('variant-changed', () => {
        setTimeout(initSizeGuide, 50);
      });

      // Also listen for form changes
      document.addEventListener('change', (e) => {
        if (e.target && e.target.name && e.target.name.includes('Size')) {
          const sizePillList = findSizePillList();
          if (sizePillList) {
            const sizeValue = e.target.value;
            const recommendation = SIZE_RECOMMENDATIONS[sizeValue];
            if (recommendation) {
              updateNotification(recommendation);
            }
          }
        }
      });
    })();
  </script>
{%- endif -%}
