{%- if product.tags contains 'size-directions' -%}

<style>
.product-size-guide{
  margin-top:15px;
}

.product-size-guide__notification{
  background:#f5f5f5;
  padding:14px;
  border-left:4px solid #000;
  font-size:14px;
  display:none;
  transition:all .2s ease;
}

.product-size-guide__notification.active{
  display:block;
}

.product-size-guide__notification strong{
  font-weight:600;
}
</style>

<div class="product-size-guide">
  <div class="product-size-guide__notification" id="sizeNote"></div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function(){

const SIZE_RULES = {
  black:{default:"● Fits true to size."},
  "mid blue":{default:"↑ We recommend going one size up."},
  grey:{"32":"↑ Size 32 — go one size up.",default:"● Fits true to size."},
  "light blue":{"32":"↑ Size 32 — go one size up.",default:"● Fits true to size."},
  default:{
    "26":"↑ Runs small — go up one size.",
    "34":"↓ Runs large — go down one size.",
    default:"● Fits true to size."
  }
};

function getSelectedOption(optionName){
  const fieldsets = document.querySelectorAll("fieldset");

  for (let field of fieldsets){
    if(field.querySelector("legend")?.textContent.toLowerCase().includes(optionName.toLowerCase())){
      const checked = field.querySelector("input:checked");
      if(checked){
        return checked.value.trim().toLowerCase();
      }
    }
  }
  return "";
}

function getMessage(color,size){
  let rules = SIZE_RULES.default;

  for(const key in SIZE_RULES){
    if(color.includes(key)){
      rules = SIZE_RULES[key];
      break;
    }
  }

  return rules[size] || rules.default;
}

function updateSizeNote(){
  const color = getSelectedOption("color");
  const size = getSelectedOption("size");
  const note = document.getElementById("sizeNote");

  if(!size || !note) return;

  note.innerHTML = `<strong>Size ${size}</strong> — ${getMessage(color,size)}`;
  note.classList.add("active");
}

/* Detect Variant Change Automatically */
document.querySelectorAll("input[type='radio']").forEach(input=>{
  input.addEventListener("change", updateSizeNote);
});

/* Initial Load */
updateSizeNote();

});
</script>

{%- endif -%}