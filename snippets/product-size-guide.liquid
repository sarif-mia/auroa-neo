{%- if product.tags contains 'size-directions' -%}

<style>
.product-size-guide{
  margin-top:15px;
}

.product-size-guide__notification{
  background:#f5f5f5;
  padding:14px;
  border-left:4px solid #000;
  font-size:14px;
  display:none;
  transition:all .2s ease;
}

.product-size-guide__notification.active{
  display:block;
}

.product-size-guide__notification strong{
  font-weight:600;
}
</style>

<div class="product-size-guide">
  <div class="product-size-guide__notification" id="sizeNote"></div>
</div>

<script>
(function(){

/* =========================
   SIZE RULE CONFIG
   ========================= */

const SIZE_RULES = {
  black: {
    default: "● Fits true to size."
  },

  "mid blue": {
    default: "↑ We recommend going one size up."
  },

  grey: {
    "32": "↑ Size 32 — go one size up.",
    default: "● Fits true to size."
  },

  "light blue": {
    "32": "↑ Size 32 — go one size up.",
    default: "● Fits true to size."
  },

  default: {
    "26": "↑ Runs small — go up one size.",
    "34": "↓ Runs large — go down one size.",
    default: "● Fits true to size."
  }
};


/* =========================
   GET SELECTED VALUE
   ========================= */

function getSelected(optionName){
  const el = document.querySelector(
    `[option-picker-name*="${optionName}"] .pill.selected .pill__label`
  );
  return el ? el.textContent.trim().toLowerCase() : '';
}


/* =========================
   GET MESSAGE BASED ON RULE
   ========================= */

function getMessage(color, size){
  let rule = SIZE_RULES.default;

  Object.keys(SIZE_RULES).forEach(key=>{
    if(color.includes(key)){
      rule = SIZE_RULES[key];
    }
  });

  return rule[size] || rule.default;
}


/* =========================
   UPDATE UI
   ========================= */

function updateSizeNote(){
  const color = getSelected('Color');
  const size  = getSelected('Size');
  const note  = document.getElementById('sizeNote');

  if(!size || !note) return;

  const message = getMessage(color, size);

  note.innerHTML = `<strong>Size ${size}</strong> — ${message}`;
  note.classList.add('active');
}


/* =========================
   EVENT LISTENERS
   ========================= */

/* Aurora custom variant event */
document.addEventListener('variant-changed', function(){
  updateSizeNote();
});

/* Pill click fallback */
document.addEventListener('click', function(e){
  if(e.target.closest('.pill')){
    // run on the next tick so the selected class is applied
    setTimeout(updateSizeNote, 0);
  }
});

/* Initial load */
document.addEventListener('DOMContentLoaded', function(){
  setTimeout(updateSizeNote, 200);
});

})();
</script>

{%- endif -%}