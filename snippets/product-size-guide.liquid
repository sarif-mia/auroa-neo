{%- liquid
  assign product_tags = product.tags
  assign has_size_directions_tag = false
  
  for tag in product_tags
    if tag == 'size-directions'
      assign has_size_directions_tag = true
      break
    endif
  endfor
-%}

{%- if has_size_directions_tag -%}
  <style>
    .product-size-guide {
      margin-top: 0.5rem;
    }

    .product-variant-picker__pill-list[data-size-recommendations] .pill {
      position: relative;
    }

    .product-variant-picker__pill-list[data-size-recommendations] .pill::before {
      content: attr(data-size-icon);
      position: absolute;
      top: -8px;
      right: -4px;
      font-size: 0.9rem;
      font-weight: bold;
      background: white;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid #ddd;
    }

    .product-size-guide__notification {
      background-color: #fff3cd;
      padding: 0.75rem;
      border-left: 4px solid #e74c3c;
      margin-top: 0.75rem;
      display: none;
      animation: slideIn 0.3s ease;
      border-radius: 3px;
    }

    .product-size-guide__notification.active {
      display: block;
    }

    .product-size-guide__notification-content {
      font-size: 0.85rem;
      line-height: 1.4;
      color: #333;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(-5px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

  <div class='product-size-guide' data-product-size-guide>
    <div class='product-size-guide__notification' data-size-notification=''>
      <div class='product-size-guide__notification-content'></div>
    </div>
  </div>

  <script>
    (function() {
      const productId = '{{ product.id }}';
      const sectionId = '{{ sectionId }}';
      
      function initSizeGuide() {
        const variantPicker = document.querySelector(`[data-section='${sectionId}'][data-product-id='${productId}']`);
        if (!variantPicker) return;

        const pillLists = variantPicker.querySelectorAll('.product-variant-picker__pill-list');
        let sizePillList = null;

        // Find the Size option pill list
        for (let list of pillLists) {
          const labels = list.parentElement.querySelectorAll('.product-variant-picker__option-label span');
          for (let label of labels) {
            if (label.textContent.toLowerCase() === 'size') {
              sizePillList = list;
              break;
            }
          }
        }

        if (!sizePillList) return;

        // Add data attribute to size pill list
        sizePillList.setAttribute('data-size-recommendations', 'true');

        const sizeRecommendations = {
          '26': { icon: '↑', text: 'Size 26 runs small — we suggest going up to size 28.' },
          '28': { icon: '●', text: 'Size 28 fits true to size.' },
          '30': { icon: '●', text: 'Size 30 fits true to size.' },
          '32': { icon: '↑', text: 'Size 32 — we recommend go one size up.' },
          '34': { icon: '↓', text: 'Size 34 runs large — we suggest going down to size 32.' },
          '36': { icon: '●', text: 'Size 36 fits true to size.' }
        };

        const pills = sizePillList.querySelectorAll('.pill');
        const notification = document.querySelector('[data-size-notification]');
        const notificationContent = notification.querySelector('.product-size-guide__notification-content');

        pills.forEach(pill => {
          const label = pill.querySelector('.pill__label');
          const size = label ? label.textContent.trim() : '';
          const rec = sizeRecommendations[size];

          if (rec) {
            pill.setAttribute('data-size-icon', rec.icon);

            pill.addEventListener('click', function() {
              if (rec.text) {
                notificationContent.textContent = rec.text;
                notification.classList.add('active');
              }
            });
          }
        });

        // Show default for first selected
        const selectedPill = sizePillList.querySelector('.pill.selected');
        if (selectedPill) {
          selectedPill.click();
        } else if (pills.length > 0) {
          pills[0].click();
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSizeGuide);
      } else {
        initSizeGuide();
      }

      // Re-init on variant change
      document.addEventListener('variant-changed', initSizeGuide);
    })();
  </script>
{%- endif -%}
